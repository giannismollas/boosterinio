# ─────────────────────────────────────────────────────────────────────────────
# Boosterinio environment variables. Copy to .env for local development and
# set the same keys in Railway → your service → Variables for production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Neon) ──────────────────────────────────────────────────────────
# Pooled connection string (host contains "-pooler"), used by the running app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/boosterinio?sslmode=require"
# Direct (non-pooled) connection string, used by migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/boosterinio?sslmode=require"
# Connections per app instance (Neon pooler handles the rest).
DATABASE_POOL_MAX=10

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://boosterinio.com"
NEXT_PUBLIC_CURRENCY="EUR"
NEXT_PUBLIC_LOCALE="en-IE"
NEXT_PUBLIC_SUPPORT_EMAIL="support@boosterinio.com"
NEXT_PUBLIC_DISCORD_URL=""
NEXT_PUBLIC_TWITTER_HANDLE=""
NEXT_PUBLIC_LEGAL_NAME="Boosterinio"
# Set to "false" on staging so search engines don't index it.
NEXT_PUBLIC_ALLOW_INDEXING="true"

# ── Security (generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))") ──
BETTER_AUTH_URL="https://boosterinio.com"
BETTER_AUTH_SECRET=""
# 32 random bytes, base64. Encrypts account logins and delivery details. NEVER change it after launch.
ENCRYPTION_KEY=""
# Protects /api/cron (scheduled order completion).
CRON_SECRET=""
# "true" blocks sign-in until the email is confirmed (needs RESEND_API_KEY).
REQUIRE_EMAIL_VERIFICATION="false"

# ── Social sign-in (optional) ────────────────────────────────────────────────
# Callback URLs: https://YOUR_DOMAIN/api/auth/callback/discord and /api/auth/callback/google
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Boosterinio <no-reply@boosterinio.com>"

# ── Payments ─────────────────────────────────────────────────────────────────
# Stripe: webhook endpoint https://YOUR_DOMAIN/api/webhooks/stripe
#   events: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# PayPal: webhook https://YOUR_DOMAIN/api/webhooks/paypal
#   events: CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
# "sandbox" or "live"
PAYPAL_MODE="sandbox"

# NOWPayments (crypto): IPN callback is set automatically per invoice.
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""
NOWPAYMENTS_SANDBOX="false"

# Development only: adds a "Test payment" method that marks orders paid without money.
PAYMENTS_TEST_MODE="false"

# ── Image uploads (S3-compatible, e.g. Cloudflare R2) ────────────────────────
# Without these, files are written to UPLOAD_DIR (mount a Railway volume there).
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL of the bucket (R2 public bucket URL or your CDN domain).
S3_PUBLIC_URL=""
UPLOAD_DIR="./uploads"
